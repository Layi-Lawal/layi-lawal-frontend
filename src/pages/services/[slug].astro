---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services, getRelatedServices } from '../../data/services';

export function getStaticPaths() {
  return services.map(s => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = services.find(s => s.slug === slug)!;
const related = getRelatedServices(slug!);
const allServices = services.filter(s => s.slug !== slug);
---

<Layout
  title={service.name}
  description={service.summary}
  variant="inner"
  pageTitle={service.name}
  pageSubtitle={service.tagline}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Services', href: '/services' },
    { label: service.name },
  ]}
>

  <!-- ═══════════════════════════════════════════════════
       OVERVIEW — description + at-a-glance sidebar
  ═══════════════════════════════════════════════════ -->
  <section class="section-pad bg-surface" aria-label="Service overview">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">

        <!-- Description -->
        <div class="lg:col-span-7">
          <p class="eyebrow mb-6">Overview</p>
          <div class="flex flex-col gap-5 font-sans font-light text-base text-ink-muted leading-relaxed">
            {service.description.map(para => (
              <p>{para}</p>
            ))}
          </div>
        </div>

        <!-- At a glance sidebar -->
        <aside class="lg:col-span-4 lg:col-start-9">
          <div class="bg-surface-alt border border-border p-8 flex flex-col gap-6 sticky top-28">
            <h2 class="font-serif text-xl font-semibold text-navy">At a glance</h2>
            <div class="rule border-border"></div>
            <ul class="flex flex-col gap-4">
              {service.includes.map(item => (
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-blue shrink-0 mt-2"></span>
                  <div>
                    <p class="font-sans font-medium text-sm text-navy">{item.title}</p>
                    <p class="font-sans font-light text-xs text-ink-muted leading-relaxed mt-0.5">{item.body}</p>
                  </div>
                </li>
              ))}
            </ul>
            <div class="rule border-border"></div>
            <Button text="Make an Enquiry" path="/contact" variant="primary" size="sm" />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       WHAT'S INCLUDED
  ═══════════════════════════════════════════════════ -->
  <section class="section-pad bg-surface-alt" aria-label="What's included">
    <div class="container-site">
      <p class="eyebrow mb-4">What's Included</p>
      <h2 class="font-serif text-4xl md:text-5xl font-semibold text-navy leading-tight mb-14 max-w-xl">
        The full scope of our {service.name.toLowerCase()} service.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-border">
        {service.includes.map(item => (
          <div class="bg-surface-alt p-8 flex flex-col gap-4">
            <span class="material-symbols-outlined text-2xl text-blue/60">{item.icon}</span>
            <h3 class="font-serif text-xl font-semibold text-navy leading-tight">{item.title}</h3>
            <p class="font-sans font-light text-sm text-ink-muted leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       WHO IT'S FOR
  ═══════════════════════════════════════════════════ -->
  <section class="section-pad bg-navy" aria-label="Who this service is for">
    <div class="container-site">
      <p class="eyebrow-light mb-4">Who This Is For</p>
      <h2 class="font-serif text-4xl md:text-5xl font-semibold text-white leading-tight mb-14 max-w-xl">
        Organisations we work with.
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {service.clientTypes.map((ct, i) => (
          <div class="border-t border-white/15 pt-8 flex flex-col gap-3">
            <span class="font-serif text-4xl font-light text-white/25 leading-none select-none">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="font-serif text-xl font-semibold text-white leading-tight">{ct.title}</h3>
            <p class="font-sans font-light text-sm text-slate leading-relaxed">{ct.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       PROCESS
  ═══════════════════════════════════════════════════ -->
  <section class="section-pad bg-surface" aria-label="Our process">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">

        <div class="lg:col-span-4">
          <p class="eyebrow mb-6">Our Process</p>
          <h2 class="font-serif text-4xl font-semibold text-navy leading-tight">
            How an engagement works.
          </h2>
        </div>

        <div class="lg:col-span-7 lg:col-start-6">
          <ol class="flex flex-col">
            {service.processSteps.map((step, i) => (
              <li class="border-t border-border py-8 flex gap-8 items-start">
                <span class="font-serif text-4xl font-light text-navy/25 leading-none select-none shrink-0 w-10">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-serif text-xl font-semibold text-navy mb-2">{step.label}</h3>
                  <p class="font-sans font-light text-sm text-ink-muted leading-relaxed">{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════
       RELATED SERVICES
  ═══════════════════════════════════════════════════ -->
  {related.length > 0 && (
    <section class="section-pad bg-surface-alt" aria-label="Related services">
      <div class="container-site">
        <p class="eyebrow mb-4">Related Services</p>
        <h2 class="font-serif text-3xl font-semibold text-navy leading-tight mb-12">
          You may also need:
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border">
          {related.map((s, i) => (
            <div class="bg-surface-alt">
              <ServiceCard slug={s.slug} name={s.name} summary={s.summary} index={i} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════════
       CTA
  ═══════════════════════════════════════════════════ -->
  <section class="section-pad bg-navy" aria-label="Get started">
    <div class="container-site">
      <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-10">
        <div>
          <p class="eyebrow-light mb-5">Ready to begin?</p>
          <h2 class="font-serif text-4xl md:text-5xl font-semibold text-white leading-tight max-w-xl">
            Let's talk about your {service.name.toLowerCase()} needs.
          </h2>
        </div>
        <div class="flex flex-col gap-4 shrink-0">
          <Button text="Make an Enquiry" path="/contact" variant="primary" size="lg" />
          <a href="/services" class="font-sans font-light text-sm text-slate hover:text-white transition-colors duration-150 text-center">
            ← All services
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
