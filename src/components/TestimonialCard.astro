---
interface Props {
  quote: string;
  name: string;
  role: string;
  organisation: string;
  featured?: boolean;
}

const { quote, name, role, organisation, featured = false } = Astro.props;
---

<figure class={featured ? 'flex flex-col gap-8' : 'flex flex-col gap-6 p-8 border border-border bg-surface'}>
  <!-- Quote mark -->
  <svg class={`${featured ? 'w-10 h-10 text-blue/30' : 'w-7 h-7 text-blue/25'} shrink-0`} viewBox="0 0 40 30" fill="currentColor" aria-hidden="true">
    <path d="M0 30V18.571C0 8.571 5.714 2.381 17.143 0L19.048 3.81C13.016 5.397 9.841 9.206 9.524 15.238H17.143V30H0zm22.857 0V18.571C22.857 8.571 28.571 2.381 40 0L41.905 3.81C35.873 5.397 32.698 9.206 32.381 15.238H40V30H22.857z" />
  </svg>

  <blockquote class={`font-serif italic leading-relaxed text-ink ${featured ? 'text-2xl md:text-3xl' : 'text-lg'}`}>
    {quote}
  </blockquote>

  <figcaption class="flex flex-col gap-0.5 mt-auto">
    <span class={`font-sans font-medium text-navy ${featured ? 'text-base' : 'text-sm'}`}>{name}</span>
    <span class={`font-sans font-light text-ink-muted ${featured ? 'text-sm' : 'text-xs'}`}>{role}, {organisation}</span>
  </figcaption>
</figure>
