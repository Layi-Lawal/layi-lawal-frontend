---
import BreadCrumb from './BreadCrumb.astro';

interface Props {
  name: string;
  tagline: string;
  icon: string;
}

const { name, tagline, icon } = Astro.props;
---

<section class="bg-navy text-white py-16">
  <div class="container-site">
    <BreadCrumb crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: name },
    ]} />
    <div class="flex items-center gap-4 mb-4">
      <span class="material-symbols-outlined text-4xl text-blue">{icon}</span>
      <h1 class="font-serif text-4xl md:text-5xl font-bold leading-tight">{name}</h1>
    </div>
    <p class="font-sans text-slate text-lg max-w-2xl leading-relaxed">{tagline}</p>
  </div>
</section>
