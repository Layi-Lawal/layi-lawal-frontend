---
const services = [
  { label: 'Audit & Assurance', href: '/services/audit' },
  { label: 'Advisory', href: '/services/advisory' },
  { label: 'Accountancy', href: '/services/accountancy' },
  { label: 'Tax', href: '/services/tax' },
  { label: 'Insolvency', href: '/services/insolvency' },
];
---

<footer class="bg-navy-900 text-white">
  <div class="container-site pt-16 pb-10">

    <!-- Main grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 pb-12 rule-dark border-b border-white/10">

      <!-- Brand column -->
      <div class="md:col-span-4 flex flex-col gap-5">
        <a href="/" class="flex items-center gap-3" aria-label="Layi Lawal & Co home">
          <img src="/images/logo-light-500.png" alt="" class="w-9 h-9 object-contain" aria-hidden="true" />
          <span class="font-sans font-medium text-sm leading-tight tracking-wide">
            Layi Lawal &amp; Co<br />
            <span class="text-slate font-light">Chartered Accountants</span>
          </span>
        </a>
        <p class="font-sans font-light text-sm text-slate leading-relaxed max-w-xs">
          Independent chartered accountancy practice based in Lagos, Nigeria — delivering audit, tax, advisory, accountancy, and insolvency services.
        </p>

        <!-- Credentials -->
        <div class="flex flex-col gap-1.5 mt-2">
          <span class="font-sans text-xs text-slate/60 uppercase tracking-widest">Regulatory standing</span>
          <div class="flex flex-wrap gap-x-4 gap-y-1 mt-1">
            <span class="font-sans text-xs text-blue-mid">FRC Licensed</span>
            <span class="font-sans text-xs text-slate/40">·</span>
            <span class="font-sans text-xs text-blue-mid">ICAN Registered</span>
            <span class="font-sans text-xs text-slate/40">·</span>
            <span class="font-sans text-xs text-blue-mid">CITN Registered</span>
          </div>
        </div>
      </div>

      <!-- Services column -->
      <div class="md:col-span-3 md:col-start-6">
        <p class="font-sans text-xs font-semibold uppercase tracking-widest text-slate/50 mb-5">Services</p>
        <ul class="flex flex-col gap-3">
          {services.map(s => (
            <li>
              <a href={s.href} class="font-sans font-light text-sm text-slate hover:text-white transition-colors duration-150">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div class="md:col-span-4 md:col-start-9">
        <p class="font-sans text-xs font-semibold uppercase tracking-widest text-slate/50 mb-5">Contact</p>
        <ul class="flex flex-col gap-4">
          <li>
            <a href="tel:+2348055421762" class="font-sans font-light text-sm text-slate hover:text-white transition-colors duration-150 block">
              +234 805 542 1762
            </a>
            <a href="tel:+2348130800920" class="font-sans font-light text-sm text-slate hover:text-white transition-colors duration-150 block mt-1">
              +234 813 080 0920
            </a>
          </li>
          <li>
            <a href="mailto:lailawal810@gmail.com" class="font-sans font-light text-sm text-slate hover:text-white transition-colors duration-150">
              lailawal810@gmail.com
            </a>
          </li>
          <li class="font-sans font-light text-sm text-slate leading-relaxed">
            Block 7, Suite 5<br />
            Oodua Shopping Complex<br />
            Ojota, Lagos — Nigeria
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="font-sans font-light text-xs text-slate/50">
        &copy; {new Date().getFullYear()} Layi Lawal &amp; Co Chartered Accountants. All rights reserved.
      </p>
      <nav aria-label="Footer links">
        <ul class="flex gap-6">
          <li><a href="/about" class="font-sans font-light text-xs text-slate/50 hover:text-white transition-colors">About</a></li>
          <li><a href="/services" class="font-sans font-light text-xs text-slate/50 hover:text-white transition-colors">Services</a></li>
          <li><a href="/contact" class="font-sans font-light text-xs text-slate/50 hover:text-white transition-colors">Contact</a></li>
        </ul>
      </nav>
    </div>
  </div>
</footer>
