---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: Crumb[];
  light?: boolean;
}

const { crumbs, light = true } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {crumbs.map((crumb, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <svg class={`w-3 h-3 shrink-0 ${light ? 'text-white/25' : 'text-ink-muted/40'}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
          </svg>
        )}
        {crumb.href
          ? (
            <a
              href={crumb.href}
              class={`font-sans font-light text-xs transition-colors duration-150 ${
                light ? 'text-white/50 hover:text-white' : 'text-ink-muted hover:text-navy'
              }`}
            >
              {crumb.label}
            </a>
          )
          : (
            <span class={`font-sans font-medium text-xs ${light ? 'text-white/80' : 'text-navy'}`}>
              {crumb.label}
            </span>
          )
        }
      </li>
    ))}
  </ol>
</nav>
