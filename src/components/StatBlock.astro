---
interface Props {
  value: string;
  label: string;
  light?: boolean;
}

const { value, label, light = false } = Astro.props;
---

<div class="flex flex-col gap-1">
  <span class={`font-serif text-5xl md:text-6xl font-semibold leading-none ${light ? 'text-white' : 'text-navy'}`}>
    {value}
  </span>
  <span class={`font-sans font-light text-xs uppercase tracking-widest mt-2 ${light ? 'text-slate' : 'text-ink-muted'}`}>
    {label}
  </span>
</div>
