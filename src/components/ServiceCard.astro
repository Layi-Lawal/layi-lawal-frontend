---
interface Props {
  name: string;
  summary: string;
}

const { name, summary } = Astro.props;
---

<div class="w-60 border hover:border-dark text-dark m-auto h-80 flex flex-col justify-evenly my-4 p-2">
  <h4 class="text-2xl">{name}</h4>
  <p class="text-center font-sans">{summary.slice(0, 180) + '...'}</p>
  <a
    href={`/services/${name.toLowerCase()}`}
    class="bg-light border border-light text-dark text-center text-xs w-fit p-4 inline-block m-2 font-sans hover:bg-opacity-20 hover:text-light"
  >
    LEARN MORE
  </a>
</div>
